{
  "name": "nano66-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Every website. Built from particles.",
  "scripts": {
    "build": "pnpm --filter nano66 build",
    "typecheck": "pnpm --filter nano66 typecheck && pnpm --filter website-2-react exec tsc --noEmit",
    "test": "pnpm --filter nano66 test",
    "test:coverage": "pnpm --filter nano66 test:coverage",
    "test:e2e": "playwright test",
    "dev:vanilla": "pnpm --filter website-1-vanilla dev",
    "dev:react": "pnpm --filter website-2-react dev",
    "lint": "eslint packages/nano66/src",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "pack:check": "pnpm --filter nano66 pack:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
